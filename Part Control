    }, { Create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }) })

    local obj = { Value = multi and {} or nil, Type = "Dropdown" }
    local optionButtons = {}
    local function isSelected(v)
        if multi then return obj.Value[v] == true end
        return obj.Value == v
    end
    local function refresh()
        if multi then
            local names = {}
            for _, v in ipairs(values) do if obj.Value[v] then table.insert(names, v) end end
            valueLabel.Text = #names > 0 and table.concat(names, ", ") or "None"
        else
            valueLabel.Text = obj.Value ~= nil and tostring(obj.Value) or "None"
        end
        for v, b in pairs(optionButtons) do
            local s = isSelected(v)
            Tween(b, 0.25, { TextColor3 = s and Theme.Accent or Theme.SubText, BackgroundTransparency = s and 0.15 or 0.5 })
        end
    end
    function obj:Set(v, silent)
        if multi then
            self.Value = {}
            for k, on in pairs(v or {}) do if on == true then self.Value[k] = true end end
        else
            self.Value = v
        end
        refresh()
        if not silent then Fire(opts.Callback, self.Value) end
