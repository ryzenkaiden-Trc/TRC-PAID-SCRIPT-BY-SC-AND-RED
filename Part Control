local function ApplyFilter()
    local q = string.lower(trim(SearchBox.Text))
    local total, shown = 0, 0
    for _, rec in pairs(Picker.Rows) do
        total += 1
        local match = q == "" or string.find(rec.Search, q, 1, true) ~= nil
        rec.Holder.Visible = match
        if match then shown += 1 end
    end
    PTitle.Text = ("Players (%d)"):format(total)
