    Bind(RunService.Heartbeat, function(dt)
        if not (PC.Enabled or NPC.Enabled or IV.Enabled) then return end
        local root = getRoot()
        if not root then return end

        PC.T = PC.T + dt
        PC.SimT = PC.SimT + dt
        if PC.SimT >= 1 then
            PC.SimT = 0
            pcall(function()
                if sethiddenproperty then sethiddenproperty(LocalPlayer, "SimulationRadius", 1e9) end
                LocalPlayer.MaximumSimulationRadius = 1e9
            end)
        end

        local cam = Workspace.CurrentCamera
        local anchor = targetRoot() or root
        env.center = anchor.Position
        env.cf = anchor.CFrame
        env.cam = cam and cam.CFrame or root.CFrame
        local rad = PC.Radius
        if PC.Breathe then rad = rad * (1 + 0.28 * math.sin(PC.T * 2.2)) end
        env.radius, env.speed, env.height = rad, (PC.Reverse and -PC.Speed or PC.Speed), PC.Height
        local ok, hit = pcall(function() return mouse.Hit end)
        local mp = (ok and hit) and hit.Position or (env.center + env.cam.LookVector * 20)
        local off = mp - env.center
        if off.Magnitude > 300 then mp = env.center + off.Unit * 300 end
        env.mouse = mp

        local fn = F[PC.Style] or F.Orbital
        local list = PC.Controlled
        local n = #list
        local spin = PC.Spin and Vector3.new(0, 12, 0) or Vector3.zero
        for i = 1, n do
            local part = list[i]
            if part.Parent and not part.Anchored then
                local target = fn(i, n, PC.T, env)
                local v = (target - part.Position) * PC.Pull
                local m = v.Magnitude
                if m > MAX_VEL then v = v * (MAX_VEL / m) end
                part.AssemblyLinearVelocity = v
                part.AssemblyAngularVelocity = spin
            end
        end

        if NPC.Enabled then
            local npcs = NPC.Controlled
            local count = #npcs
            local ne = NPC.Env
            local npcAnchor = NPC.Anchor() or root
            local nrad = NPC.Radius
            if PC.Breathe then nrad = nrad * (1 + 0.28 * math.sin(PC.T * 2.2)) end
            ne.center, ne.cf, ne.cam, ne.mouse = npcAnchor.Position, npcAnchor.CFrame, env.cam, env.mouse
            ne.radius, ne.speed, ne.height = nrad, env.speed, env.height
            for i = 1, count do
                local e = npcs[i]
                local part = e.Root
                if part.Parent and not part.Anchored and e.Humanoid.Health > 0 then
                    if not e.Humanoid.PlatformStand then e.Humanoid.PlatformStand = true end
                    local target = NPC.Place(i, count, PC.T, ne)
                    local v = (target - part.Position) * PC.Pull
                    local m = v.Magnitude
                    if m > MAX_VEL then v = v * (MAX_VEL / m) end
                    part.AssemblyLinearVelocity = v
                    part.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end

        if IV.Enabled then
            if IV.AntiFling then
                if root.AssemblyLinearVelocity.Magnitude > 200 or root.AssemblyAngularVelocity.Magnitude > 30 then
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                end
            end
            local items = IV.Items
            local count = #items
            if count > 0 then
                local ie = IV.Env
                local irad = IV.Radius
                if PC.Breathe then irad = irad * (1 + 0.28 * math.sin(PC.T * 2.2)) end
                ie.center, ie.cf, ie.cam, ie.mouse = env.center, env.cf, env.cam, env.mouse
                ie.radius, ie.speed, ie.height = irad, env.speed, env.height
                local ifn = F[IV.Style] or F.Orbital
                for i = 1, count do
                    local part = items[i].Handle
                    if part.Parent and not part.Anchored then
                        local target = ifn(i, count, PC.T, ie)
                        local v = (target - part.Position) * PC.Pull
                        local m = v.Magnitude
                        if m > MAX_VEL then v = v * (MAX_VEL / m) end
                        part.AssemblyLinearVelocity = v
                        part.AssemblyAngularVelocity = Vector3.zero
                        if IV.Face then
                            local dir = part.Position - env.center
                            if dir.Magnitude > 0.1 then
                                part.CFrame = CFrame.lookAt(part.Position, part.Position + dir)
                            end
                        end
                    end
                end
            end
        end
    end)

