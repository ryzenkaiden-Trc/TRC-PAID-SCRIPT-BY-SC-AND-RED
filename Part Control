local function MakeDraggable(handle, target, onTap)
    local dragging, moved = false, false
    local startInput, startPos, startCenter
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == MB1 or input.UserInputType == TOUCH then
            dragging, moved = true, false
            startInput = input.Position
            startPos = target.Position
            startCenter = target.AbsolutePosition + target.AbsoluteSize * target.AnchorPoint
            local conn
            conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    conn:Disconnect()
                    if not moved and onTap then onTap() end
                end
            end)
        end
    end)
    Bind(UIS.InputChanged, function(input)
        if not dragging then return end
        if input.UserInputType ~= MOVE and input.UserInputType ~= TOUCH then return end
        local d = input.Position - startInput
        if not moved and d.Magnitude < 6 then return end
        moved = true
        local vp = Gui.AbsoluteSize
        local cx = math.clamp(startCenter.X + d.X, 30, vp.X - 30)
        local cy = math.clamp(startCenter.Y + d.Y, 30, vp.Y - 30)
        target.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + (cx - startCenter.X),
            startPos.Y.Scale, startPos.Y.Offset + (cy - startCenter.Y)
        )
    end)
end

