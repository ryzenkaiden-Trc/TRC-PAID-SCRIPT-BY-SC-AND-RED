function Section:AddToggle(flag, opts)
    opts = opts or {}
    local holder = RowHolder(self.Frame, RowH, self:_order())
    local body = Body(holder)
    local label = RowLabel(body, opts.Text or flag, -64)
    local track = Create("Frame", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(38, 20),
        BackgroundColor3 = Theme.Off, BorderSizePixel = 0, Parent = body,
    }, { Round() })
    local knob = Create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 10, 0.5, 0), Size = UDim2.fromOffset(14, 14),
        BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = track,
    }, { Round() })

    local obj = { Value = false, Type = "Toggle" }
    local function render()
        local on = obj.Value
        Tween(track, 0.25, { BackgroundColor3 = on and Theme.Accent or Theme.Off })
        Tween(knob, 0.35, {
            Position = on and UDim2.new(1, -10, 0.5, 0) or UDim2.new(0, 10, 0.5, 0),
            BackgroundColor3 = on and Theme.Window or Color3.new(1, 1, 1),
        }, Enum.EasingStyle.Back)
    end
    function obj:Set(v, silent)
        self.Value = v and true or false
        render()
        if not silent then Fire(opts.Callback, self.Value) end
    end
    Tactile(body, body, 0.97, 0.93, function(i) Ripple(body, i) end)
    body.MouseButton1Click:Connect(function()
        obj:Set(not obj.Value)
        Pulse(knob)
    end)
    if opts.Default then obj:Set(true, true) end
    TRC.Flags[flag] = obj
    return obj
end

function Section:AddButton(opts)
