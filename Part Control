        Tween(holder, 0.4, { Size = UDim2.new(1, 0, 0, s and (RowH + 4 + #values * (optH + 4)) or RowH) })
        Tween(arrow, 0.3, { Rotation = s and 180 or 0 }, Enum.EasingStyle.Back)
