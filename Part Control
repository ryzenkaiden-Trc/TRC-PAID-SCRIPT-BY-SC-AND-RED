function TRC:SetOpen(state)
    if self.Open == state then return end
    self.Open = state
    SetLauncherIcon(state)
    if state then
        Holder.Visible = true
        Win.GroupTransparency = 1
        WinScale.Scale = 0.84
        Win.Position = UDim2.new(0.5, 0, 0.5, 28)
        Shadow.GroupTransparency = 1
        ShadowScale.Scale = 0.84
        Sweep.Position = UDim2.fromScale(-0.6, 0)
        Tween(Win, 0.5, { GroupTransparency = 0 })
        Tween(Win, 0.75, { Position = UDim2.fromScale(0.5, 0.5) })
        Tween(WinScale, 0.75, { Scale = 1 }, Enum.EasingStyle.Back)
        Tween(Shadow, 0.9, { GroupTransparency = 0 })
        Tween(ShadowScale, 0.85, { Scale = 1 }, Enum.EasingStyle.Back)
        Tween(Sweep, 1.4, { Position = UDim2.fromScale(1.2, 0) })
        BorderTween:Play()
        ringTween1:Pause(); ringTween2:Pause(); ring.Visible = false
        Pulse(Core)
        PlayIntro()
    else
        if TRC.Picker then TRC.Picker:Hide() end
        Tween(Win, 0.3, { GroupTransparency = 1 })
        Tween(Win, 0.35, { Position = UDim2.new(0.5, 0, 0.5, 18) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        Tween(WinScale, 0.35, { Scale = 0.9 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        Tween(Shadow, 0.3, { GroupTransparency = 1 })
        Tween(ShadowScale, 0.35, { Scale = 0.9 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        task.delay(0.36, function()
            if not TRC.Open then
                Holder.Visible = false
                BorderTween:Pause()
            end
        end)
        ring.Visible = true
        ring.Size = UDim2.fromScale(1, 1)
        ringTween1:Play(); ringTween2:Play()
    end
    ApplyBlur()
end

