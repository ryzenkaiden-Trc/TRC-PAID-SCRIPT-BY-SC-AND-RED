local RowState = setmetatable({}, { __mode = "k" })
local function StaggerPage(tab, baseDelay)
    baseDelay = baseDelay or 0
    local idx = 0
    for _, sec in ipairs(tab.Scroller:GetChildren()) do
        if sec:IsA("Frame") then
            for _, row in ipairs(sec:GetChildren()) do
                if row:IsA("Frame") and row.Name == "Row" and row.Visible then
                    local item = row:FindFirstChildWhichIsA("GuiObject")
                    if item then
                        idx += 1
                        local st = RowState[item]
                        if not st then
                            st = { base = item.Position, gen = 0 }
                            RowState[item] = st
                        end
                        st.gen += 1
                        local gen = st.gen
                        if st.tween then st.tween:Cancel() end
                        item.Position = st.base + UDim2.fromOffset(0, 16)
                        task.delay(baseDelay + math.min(idx * 0.045, 0.55), function()
                            if st.gen == gen and item.Parent then
                                st.tween = Tween(item, 0.6, { Position = st.base })
                            end
                        end)
                    end
                end
            end
        end
    end
end

function Window:_select(tab)
    local old = self.Current
    if old == tab then return end
    self.Current = tab
    if old then
        Tween(old.Btn, 0.25, { BackgroundTransparency = 1 })
        Tween(old.Label, 0.25, { TextColor3 = Theme.SubText })
        Tween(old.Bar, 0.25, { Size = UDim2.fromOffset(3, 0) })
        Tween(old.Page, 0.2, { GroupTransparency = 1 })
        task.delay(0.2, function()
            if self.Current ~= old then old.Page.Visible = false end
        end)
    end
    tab.Page.Visible = true
    tab.Page.GroupTransparency = 1
    tab.Page.Position = UDim2.fromOffset(0, 14)
    Tween(tab.Page, 0.45, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) })
    StaggerPage(tab, 0.05)
    Tween(tab.Btn, 0.25, { BackgroundTransparency = 0.85 })
    Tween(tab.Label, 0.25, { TextColor3 = Theme.Text })
    Tween(tab.Bar, 0.35, { Size = UDim2.fromOffset(3, 16) }, Enum.EasingStyle.Back)
end

