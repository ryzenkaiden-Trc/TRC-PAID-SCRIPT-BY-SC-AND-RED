    return LocalPlayer:WaitForChild("PlayerGui")
end

local function trim(s)
    return (s:gsub("^%s*(.-)%s*$", "%1"))
end

local function isWhitelisted(name)
    name = string.lower(name)
    for _, n in ipairs(Config.Whitelist) do
        if string.lower(n) == name then return true end
    end
    return false
end

local function hasSeen()
    local id = tostring(LocalPlayer.UserId)
    if getgenv and getgenv().TRC_SERVICE_SEEN == id then return true end
    if isfile and readfile then
        local ok, data = pcall(function()
            if isfile(Config.SeenFile) then return readfile(Config.SeenFile) end
        end)
        if ok and type(data) == "string" then
            for entry in string.gmatch(data, "[^,%s]+") do
                if entry == id then return true end
            end
        end
    end
    return false
end

local function markSeen()
    local id = tostring(LocalPlayer.UserId)
    if getgenv then getgenv().TRC_SERVICE_SEEN = id end
    if writefile then
        pcall(function()
            local data = ""
            if isfile and isfile(Config.SeenFile) then data = readfile(Config.SeenFile) end
            for entry in string.gmatch(data, "[^,%s]+") do
                if entry == id then return end
            end
            writefile(Config.SeenFile, data .. id .. ",")
        end)
    end
end

