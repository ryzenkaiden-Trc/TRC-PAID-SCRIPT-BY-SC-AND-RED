local function Create(class, props, children)
    local inst = Instance.new(class)
    local parent
    for k, v in pairs(props or {}) do
        if k == "Parent" then parent = v else inst[k] = v end
    end
    for _, child in ipairs(children or {}) do child.Parent = inst end
    if parent then inst.Parent = parent end
    return inst
end
local function Round() return Create("UICorner", { CornerRadius = UDim.new(1, 0) }) end
local function Corner(r) return Create("UICorner", { CornerRadius = UDim.new(0, r) }) end
local function Stroke(transp, color, thick)
    return Create("UIStroke", {
        Color = color or WHITE, Transparency = transp or 0.9, Thickness = thick or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    })
end
local function Tween(inst, time, props, style, dir)
    local t = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
    t:Play()
    return t
end
local function Loop(inst, time, props, delay, reverse, style)
    local t = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Sine,
        Enum.EasingDirection.InOut, -1, reverse or false, delay or 0), props)
    t:Play()
    return t
end
local function KP(t, v) return NumberSequenceKeypoint.new(t, v) end
local function CK(t, c) return ColorSequenceKeypoint.new(t, c) end

local function Ripple(target, input, color)
    local size = target.AbsoluteSize
    if size.X <= 0 or size.Y <= 0 then return end
    local abs = target.AbsolutePosition
    local px, py = size.X / 2, size.Y / 2
    if input and input.Position then px, py = input.Position.X - abs.X, input.Position.Y - abs.Y end
    local circle = Create("Frame", {
        BackgroundColor3 = color or WHITE, BackgroundTransparency = 0.78, BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(math.clamp(px / size.X, 0, 1), math.clamp(py / size.Y, 0, 1)),
        Size = UDim2.fromScale(0, 0), ZIndex = 5, Parent = target,
    }, { Round(), Create("UIAspectRatio", { AspectRatio = 1, DominantAxis = Enum.DominantAxis.Width }) })
    Tween(circle, 0.6, { Size = UDim2.fromScale(2.6, 2.6), BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
    task.delay(0.65, function() circle:Destroy() end)
end

local function Pulse(target, color)
    local stroke = Stroke(0.3, color or KTheme.Accent, 2)
    local ring = Create("Frame", {
        BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromScale(1, 1), ZIndex = 4, Parent = target,
    }, { Round(), stroke })
    Tween(ring, 0.6, { Size = UDim2.new(1, 16, 1, 16) }, Enum.EasingStyle.Quad)
    Tween(stroke, 0.6, { Transparency = 1 }, Enum.EasingStyle.Quad)
    task.delay(0.65, function() ring:Destroy() end)
end

local function Tactile(hit, scaleTarget, hoverScale, downScale, onDown)
    hoverScale, downScale = hoverScale or 0.97, downScale or 0.92
    local sc = scaleTarget:FindFirstChildOfClass("UIScale") or Create("UIScale", { Parent = scaleTarget })
    local hovering, pressed = false, false
    local function refresh()
        if pressed then
            Tween(sc, 0.08, { Scale = downScale }, Enum.EasingStyle.Quad)
        else
            Tween(sc, 0.35, { Scale = hovering and hoverScale or 1 }, Enum.EasingStyle.Back)
        end
    end
    hit.MouseEnter:Connect(function() hovering = true; if not pressed then refresh() end end)
    hit.MouseLeave:Connect(function() hovering = false; pressed = false; refresh() end)
    hit.InputBegan:Connect(function(input)
        if input.UserInputType == MB1 or input.UserInputType == TOUCH then
            pressed = true
            refresh()
            if onDown then onDown(input) end
        end
    end)
    hit.InputEnded:Connect(function(input)
        if input.UserInputType == MB1 or input.UserInputType == TOUCH then
            pressed = false
            if input.UserInputType == TOUCH then hovering = false end
            refresh()
        end
    end)
end

local function getGuiParent()
