            if d:IsA("Humanoid") and d.Health > 0 then
                local model = d.Parent
                if model and model:IsA("Model") and model ~= LocalPlayer.Character
                    and not Players:GetPlayerFromCharacter(model) then
                    local part = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                    if part and part:IsA("BasePart") and not part.Anchored
                        and (part.Position - origin).Magnitude <= PC.ScanRadius then
                        table.insert(found, { Model = model, Humanoid = d, Root = part })
                    end
                end
            end
        end

        table.sort(found, function(a, b)
            return (a.Root.Position - origin).Magnitude < (b.Root.Position - origin).Magnitude
        end)
        NPC.Detected = found
        NPC.Scanning = false
        return found
    end

    function NPC.Release(e)
        pcall(function()
            for part, collide in pairs(e.Parts or {}) do
                if part.Parent then part.CanCollide = collide end
            end
            e.Root.AssemblyLinearVelocity = Vector3.zero
            e.Root.AssemblyAngularVelocity = Vector3.zero
            if e.Humanoid.Parent then e.Humanoid.PlatformStand = e.Platform or false end
        end)
    end

    function NPC.ReleaseAll()
