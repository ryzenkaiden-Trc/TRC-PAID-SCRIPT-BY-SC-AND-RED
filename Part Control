    local function getRoot()
        local char = LocalPlayer.Character
        return char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
    end

    local function targetRoot()
        local plr = PC.Target
        if PC.OrbitPlayer and plr and plr.Parent then
            local c = plr.Character
            return c and (c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart)
        end
        return nil
    end

    local function inCharacter(part)
        local model = part:FindFirstAncestorOfClass("Model")
        while model do
            if model:FindFirstChildOfClass("Humanoid") then return true end
            local p = model.Parent
            model = p and p:FindFirstAncestorOfClass("Model") or nil
        end
        return false
    end

    local function isUnwelded(part)
        return part.Parent ~= nil and not part.Anchored
    end

    local function Scan()
        if PC.Scanning then return PC.Detected end
        PC.Scanning = true
        local found = {}
        local root = getRoot()
        local origin = root and root.Position or Vector3.zero

        local checked = 0
        for _, p in ipairs(Workspace:GetDescendants()) do
            checked = checked + 1
            if checked % 300 == 0 then task.wait() end
            if p:IsA("BasePart") and not p:IsA("Terrain")
                and isUnwelded(p)
                and math.max(p.Size.X, p.Size.Y, p.Size.Z) <= PC.MaxSize
                and math.max(p.Size.X, p.Size.Y, p.Size.Z) >= PC.MinSize
                and (p.Position - origin).Magnitude <= PC.ScanRadius
                and not inCharacter(p) then
                table.insert(found, p)
            end
        end

        table.sort(found, function(a, b)
            return (a.Position - origin).Magnitude < (b.Position - origin).Magnitude
        end)
        PC.Detected = found
        PC.Scanning = false
        return found
    end

    local function UpdateStatus()
        if not statusLabel then return end
        local n = #PC.Detected
        if n > 0 then
            statusLabel:SetText(("Scan Detection: %d unwelded part%s detected"):format(n, n == 1 and "" or "s"))
        else
            statusLabel:SetText("Scan Detection: no unwelded part detected")
        end
    end

    local function UpdateControlled()
        if not controlledLabel then return end
        local text = ("Controlling: %d part%s"):format(#PC.Controlled, #PC.Controlled == 1 and "" or "s")
        if isnetworkowner then
            local owned = 0
            for _, p in ipairs(PC.Controlled) do
                local ok, r = pcall(isnetworkowner, p)
                if ok and r then owned = owned + 1 end
            end
            text = text .. ("  |  owned: %d"):format(owned)
        end
        controlledLabel:SetText(text)
    end

    local function Release(part)
        local original = PC.Original[part]
        if original ~= nil then
            pcall(function()
                part.CanCollide = original
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            end)
            PC.Original[part] = nil
        end
    end

    local function ReleaseAll()
        for part in pairs(PC.Original) do Release(part) end
        PC.Controlled = {}
    end

    local function Capture(list)
        local limit = math.max(1, math.floor(PC.Limit))
        local detected = {}
        for _, p in ipairs(list) do detected[p] = true end

        local new, inNew = {}, {}
        for _, p in ipairs(PC.Controlled) do
            if detected[p] and #new < limit then
                table.insert(new, p)
                inNew[p] = true
            end
        end
        for _, p in ipairs(list) do
            if #new >= limit then break end
            if not inNew[p] then
                table.insert(new, p)
                inNew[p] = true
            end
        end

        for _, p in ipairs(new) do
            if PC.Original[p] == nil then
                PC.Original[p] = p.CanCollide
                p.CanCollide = false
            end
        end
        for part in pairs(PC.Original) do
            if not inNew[part] then Release(part) end
        end
        PC.Controlled = new
    end

    local TAU = math.pi * 2
    local F = {}

    function F.Orbital(i, n, t, e)
        local perRing = 12
        local ring = math.floor((i - 1) / perRing)
        local idx = (i - 1) % perRing
        local inRing = math.min(perRing, n - ring * perRing)
        local dir = (ring % 2 == 0) and 1 or -1
        local a = idx / inRing * TAU + t * e.speed * dir
        local r = e.radius + ring * 2.5
        local tilt = CFrame.Angles(ring * 0.45, 0, ring * 0.3)
        return e.center + Vector3.new(0, e.height, 0) + tilt * Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
    end

    local function dragonPath(s, e)
        local R = math.max(e.radius, 4)
        return e.center + Vector3.new(math.cos(s) * R, e.height + 2 + math.sin(s * 2) * 3, math.sin(s) * R)
    end

    function F.Dragon(i, n, t, e)
        local R = math.max(e.radius, 4)
        local gap = 2.4 / R
        local s = t * e.speed
        local body = math.max(1, math.floor(n * 0.6))
        if i <= body then
            return dragonPath(s - (i - 1) * gap, e)
        end
        local w = i - body - 1
        local half = math.max(1, math.ceil((n - body) / 2))
        local side = (w % 2 == 0) and 1 or -1
        local j = math.floor(w / 2) + 1
        local sh = s - 7 * gap
        local p0 = dragonPath(sh, e)
        local frame = CFrame.lookAt(p0, dragonPath(sh + 0.05, e))
        local k = j / half
        local flap = math.sin(s * 2.5) * 0.55
        local off = Vector3.new(side * (1.5 + k * e.radius * 1.4), -(j % 3) * 0.6, k * e.radius * 0.5 + (j % 3) * 1.2)
        return (frame * CFrame.Angles(0, 0, side * flap)) * off
    end

    function F.Tornado(i, n, t, e)
        local f = (i - 1) / math.max(n - 1, 1)
        local a = f * TAU * 3 + t * e.speed * 3
        local r = e.radius * (0.25 + f * 0.9)
        local y = f * (e.radius * 2 + 6) - 2 + e.height * 0.25
        return e.center + Vector3.new(math.cos(a) * r, y, math.sin(a) * r)
    end

    function F.Sphere(i, n, t, e)
        local y = 1 - ((i - 0.5) / n) * 2
        local rad = math.sqrt(math.max(0, 1 - y * y))
        local th = (i - 0.5) * 2.399963
        local v = Vector3.new(math.cos(th) * rad, y, math.sin(th) * rad) * e.radius
        local rot = CFrame.Angles(t * e.speed * 0.3, t * e.speed, 0)
        return e.center + Vector3.new(0, e.height, 0) + rot * v
    end

    function F.Galaxy(i, n, t, e)
        local arms = 3
        local arm = (i - 1) % arms
        local f = i / n
        local r = 2 + f * e.radius * 1.6
        local a = arm * TAU / arms + f * 6 + t * e.speed / (0.6 + f)
        return e.center + Vector3.new(math.cos(a) * r, e.height + math.sin(i * 1.7) * 0.8, math.sin(a) * r)
    end

    function F.Helix(i, n, t, e)
        local strand = (i - 1) % 2
        local f = math.floor((i - 1) / 2) / math.max(n / 2, 1)
        local a = f * TAU * 3 + strand * math.pi + t * e.speed * 2
        local r = e.radius * 0.45
        return e.center + Vector3.new(math.cos(a) * r, -2 + f * (e.radius * 2.2 + 4), math.sin(a) * r)
    end

    function F.Halo(i, n, t, e)
        local a = (i - 1) / n * TAU + t * e.speed
        local r = math.max(e.radius * 0.5, 3)
        return e.center + Vector3.new(math.cos(a) * r, 4.5 + e.height * 0.3, math.sin(a) * r)
    end

    function F.Wings(i, n, t, e)
        local side = (i % 2 == 0) and 1 or -1
        local j = math.ceil(i / 2)
        local half = math.max(1, math.ceil(n / 2))
        local row = (j - 1) % 3
        local col = math.floor((j - 1) / 3)
        local cols = math.max(1, math.ceil(half / 3))
        local k = col / cols
        local flap = math.sin(t * e.speed * 3) * 0.4 * (0.3 + k)
        local off = Vector3.new(side * (1.8 + k * e.radius * 1.1), 1.5 + k * e.radius * 0.35 - row * 1.6, 1.2 + row * 0.5 + k * 1.5)
        local rot = e.cf - e.cf.Position
        return e.center + (rot * CFrame.Angles(0, 0, side * flap)) * off
    end

    function F.Wall(i, n, t, e)
        local cols = math.max(1, math.ceil(math.sqrt(n * 1.6)))
        local col = (i - 1) % cols
        local row = math.floor((i - 1) / cols)
        local x = (col - (cols - 1) / 2) * 2.4
        local y = row * 2.4 - 1 + e.height * 0.3
        local sway = math.sin(t * e.speed + col * 0.5) * 0.4
        local rot = e.cf - e.cf.Position
        return e.center + rot * Vector3.new(x, y, -(e.radius * 0.5) + sway)
    end

    function F.Heart(i, n, t, e)
        local per = 28
        local layer = math.floor((i - 1) / per)
        local idx = (i - 1) % per
        local layers = math.max(1, math.ceil(n / per))
        local u = idx / per * TAU
        local x = 16 * math.sin(u) ^ 3
        local y = 13 * math.cos(u) - 5 * math.cos(2 * u) - 2 * math.cos(3 * u) - math.cos(4 * u)
        local s = (e.radius / 22) * (1 - layer * 0.5 / layers) * (1 + 0.08 * math.sin(t * e.speed * 4))
        local rot = e.cf - e.cf.Position
        return e.center + rot * Vector3.new(x * s, y * s + 4 + e.height * 0.4, -(e.radius * 0.9))
    end

    function F.Cube(i, n, t, e)
        local side = math.max(1, math.ceil(n ^ (1 / 3)))
        local idx = i - 1
        local x = idx % side
        local y = math.floor(idx / side) % side
        local z = math.floor(idx / (side * side))
        local sp = math.max(e.radius * 1.6 / side, 2)
        local v = Vector3.new(x - (side - 1) / 2, y - (side - 1) / 2, z - (side - 1) / 2) * sp
        local rot = CFrame.Angles(t * e.speed * 0.5, t * e.speed * 0.8, t * e.speed * 0.3)
        return e.center + Vector3.new(0, e.height + 3, 0) + rot * v
    end

    function F.Cursor(i, n, t, e)
        local a = i * 0.7 + t * e.speed * 2
        local r = 1.5 + (i % 6) * (e.radius / 12)
        return e.mouse + Vector3.new(math.cos(a) * r, 2 + (i % 5) * 0.8 + e.height * 0.2, math.sin(a) * r)
    end

    function F.Robot(i, n, t, e)
        local limb = (i - 1) % 5
        local seg = math.floor((i - 1) / 5)
        local swing = math.sin(t * e.speed * 2)
        local rot = e.cf - e.cf.Position
        local off
        if limb <= 1 then
            local side = limb == 0 and -1 or 1
            local ang = 0.7 + 0.5 * swing * side
            local len = 1.4 + seg * 2.2
            off = Vector3.new(side * 1.6 + side * math.cos(ang) * len, 1 - math.sin(ang) * len, 0)
        elseif limb <= 3 then
            local side = limb == 2 and -1 or 1
            local ang = 0.5 * swing * side
            local len = 1.0 + math.min(seg, 2) * 0.3
            off = Vector3.new(side * 0.9, -1.2 - math.cos(ang) * len, math.sin(ang) * len - math.max(seg - 2, 0) * 1.4)
        else
            off = Vector3.new(math.sin(t * e.speed) * 0.3, 3.2 + seg * 1.6, 0)
        end
        return e.center + rot * off
    end

    function F.Spider(i, n, t, e)
        local leg = (i - 1) % 8
        local seg = math.floor((i - 1) / 8)
        local a = (leg + 0.5) / 8 * TAU
        local r = 3 + seg * 2.5
        local lift = math.max(0, math.sin(t * e.speed * 3 + leg * math.pi / 2)) * 1.2
        local y = math.max(2.5 - seg * 1.6, -2.6) + lift
        local rot = e.cf - e.cf.Position
        return e.center + rot * Vector3.new(math.cos(a) * r, y, math.sin(a) * r)
    end

    local StyleNames = { "Orbital", "Dragon", "Tornado", "Sphere", "Galaxy", "Helix", "Halo", "Wings", "Wall", "Heart", "Cube", "Cursor", "Robot", "Spider" }

