local GameTab = Window:AddTab("Game")
do
    local RunService = game:GetService("RunService")
    local Workspace = game:GetService("Workspace")

    local PC = {
        Alive = true,
        Enabled = false,
        AutoScan = true,
        Style = "Orbital",
        Radius = 12,
        Speed = 1.5,
        Height = 4,
        Pull = 25,
