    function IV.Attach(e)
        local char = LocalPlayer.Character
        if not char then return false end
        if e.Tool.Parent ~= char then
            if not IV.AutoEquip then return false end
            pcall(function() e.Tool.Parent = char end)
            if e.Tool.Parent ~= char then return false end
        end
        e.Parts = {}
        for _, p in ipairs(e.Tool:GetDescendants()) do
            if p:IsA("BasePart") then
                e.Parts[p] = p.CanCollide
                p.CanCollide = false
            end
        end
        return true
    end

    function IV.Detach(e)
        pcall(function()
            for _, j in ipairs(e.Handle:GetJoints()) do
                if j:IsA("JointInstance") or j:IsA("WeldConstraint") then
                    local other = (j.Part0 == e.Handle) and j.Part1 or j.Part0
                    if other and not other:IsDescendantOf(e.Tool) then j:Destroy() end
                end
            end
        end)
    end

    function IV.Release(e)
        pcall(function()
            for part, collide in pairs(e.Parts or {}) do
                if part.Parent then part.CanCollide = collide end
            end
            e.Handle.AssemblyLinearVelocity = Vector3.zero
            e.Handle.AssemblyAngularVelocity = Vector3.zero
        end)
        pcall(function()
            local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
            if backpack and e.Tool.Parent then e.Tool.Parent = backpack end
            if e.WasEquipped then
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if hum then hum:EquipTool(e.Tool) end
            end
        end)
    end

    function IV.ReleaseAll()
