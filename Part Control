    function NPC.Capture(list)
        local limit = math.max(1, math.floor(NPC.Limit))
        local detected = {}
        for _, e in ipairs(list) do detected[e.Model] = e end

        local new, inNew = {}, {}
        for _, e in ipairs(NPC.Controlled) do
            if detected[e.Model] and #new < limit then
                table.insert(new, e)
                inNew[e.Model] = true
            end
        end
        for _, e in ipairs(list) do
            if #new >= limit then break end
            if not inNew[e.Model] then
                e.Parts = {}
                for _, p in ipairs(e.Model:GetDescendants()) do
                    if p:IsA("BasePart") then
                        e.Parts[p] = p.CanCollide
                        p.CanCollide = false
                    end
                end
                e.Platform = e.Humanoid.PlatformStand
                e.Humanoid.PlatformStand = true
                table.insert(new, e)
                inNew[e.Model] = true
            end
        end
        for _, e in ipairs(NPC.Controlled) do
            if not inNew[e.Model] then NPC.Release(e) end
        end
        NPC.Controlled = new
    end

    function NPC.Place(i, n, t, e)
        if NPC.Mode == "Follow" then
            local k = e.radius / 12
            local cols = 5
            local col = (i - 1) % cols
            local row = math.floor((i - 1) / cols)
            local rot = e.cf - e.cf.Position
            return e.center + rot * Vector3.new((col - (cols - 1) / 2) * 4 * k, 0, (5 + row * 4) * k)
        elseif NPC.Mode == "Cursor" then
            local ring = math.floor((i - 1) / 8)
            local a = ((i - 1) % 8) / 8 * TAU + t * e.speed
            local r = (3 + ring * 4) * (e.radius / 12)
            return e.mouse + Vector3.new(math.cos(a) * r, 3, math.sin(a) * r)
        end
        return (F[NPC.Style] or F.Orbital)(i, n, t, e)
    end

    function NPC.Anchor()
        if NPC.FollowCamera then
            local cam = Workspace.CurrentCamera
            local subject = cam and cam.CameraSubject
            if subject and subject:IsA("Humanoid") then
                local plr = Players:GetPlayerFromCharacter(subject.Parent)
                if plr and plr ~= LocalPlayer then
                    local c = plr.Character
                    local r = c and (c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart)
                    if r then return r end
                end
            end
        end
        local plr = NPC.Target
        if NPC.OrbitPlayer and plr and plr.Parent then
            local c = plr.Character
            return c and (c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart)
        end
        return nil
    end

