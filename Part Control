        radius = PC.Radius, speed = PC.Speed, height = PC.Height,
    }
    local mouse = LocalPlayer:GetMouse()
    local MAX_VEL = 400
    NPC.Env = {
        center = Vector3.zero, cf = CFrame.new(), cam = CFrame.new(), mouse = Vector3.zero,
        radius = NPC.Radius, speed = PC.Speed, height = PC.Height,
    }
