            TextColor3 = Theme.SubText, TextWrapped = true,
            Position = UDim2.fromOffset(4, 6), Size = UDim2.new(1, -8, 0, 32), Parent = body,
        })
        local sub = Create("TextLabel", {
            BackgroundTransparency = 1, Text = o.Sub or "", Font = Enum.Font.Gotham, TextSize = 11,
            TextColor3 = Theme.SubText, Position = UDim2.new(0, 4, 1, -22), Size = UDim2.new(1, -8, 0, 16), Parent = body,
        })
        Tactile(body, body, 0.96, 0.9, function(inp) Ripple(body, inp) end)
        cards[i] = { Title = title, Sub = sub, Button = body, Name = o.Name }
    end

    local highlight = Create("Frame", {
        BackgroundColor3 = Theme.Accent, BackgroundTransparency = 0.86, BorderSizePixel = 0,
        Position = slot(obj.Index), Size = cardSize, ZIndex = 4, Parent = strip,
    }, { Corner(8), Stroke(0.05, Theme.Accent, 1.5) })

    function obj:Select(i, instant)
        self.Index = i
        if instant then
            highlight.Position = slot(i)
        else
            Tween(highlight, 0.5, { Position = slot(i) }, Enum.EasingStyle.Back)
        end
        for k, c in ipairs(cards) do
            local on = k == i
            local titleColor = on and Theme.Text or Theme.SubText
            local subColor = on and Theme.Accent or Theme.SubText
            if instant then
                c.Title.TextColor3 = titleColor
                c.Sub.TextColor3 = subColor
            else
                Tween(c.Title, 0.3, { TextColor3 = titleColor })
                Tween(c.Sub, 0.3, { TextColor3 = subColor })
            end
        end
    end

    for i, c in ipairs(cards) do
        c.Button.MouseButton1Click:Connect(function()
            if i == obj.Index then return end
            if type(opts.Callback) == "function" and opts.Callback(i, c.Name) == false then return end
            obj:Select(i)
        end)
    end

    obj:Select(obj.Index, true)
    return obj
end

