local function Ripple(target, input, color)
    local size = target.AbsoluteSize
    if size.X <= 0 or size.Y <= 0 then return end
    local abs = target.AbsolutePosition
    local px, py = size.X / 2, size.Y / 2
    if input and input.Position then
        px, py = input.Position.X - abs.X, input.Position.Y - abs.Y
    end
    local circle = Create("Frame", {
        Name = "Ripple",
        BackgroundColor3 = color or Color3.new(1, 1, 1),
        BackgroundTransparency = 0.78,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(math.clamp(px / size.X, 0, 1), math.clamp(py / size.Y, 0, 1)),
        Size = UDim2.fromScale(0, 0),
        ZIndex = 5,
        Parent = target,
    }, {
        Round(),
        Create("UIAspectRatio", { AspectRatio = 1, DominantAxis = Enum.DominantAxis.Width }),
    })
    Tween(circle, 0.6, { Size = UDim2.fromScale(2.6, 2.6), BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
    task.delay(0.65, function() circle:Destroy() end)
end

