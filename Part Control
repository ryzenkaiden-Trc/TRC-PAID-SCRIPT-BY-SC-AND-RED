    local cardSize = UDim2.new(1 / count, -gap * (count - 1) / count, 1, 0)
    local function slot(i)
        return UDim2.new((i - 1) / count, (i - 1) * gap / count, 0, 0)
    end

    local cards = {}
    local obj = { Index = opts.Default or 1 }

    for i, o in ipairs(options) do
        local cell = Create("Frame", { BackgroundTransparency = 1, Position = slot(i), Size = cardSize, Parent = strip })
