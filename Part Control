    function IV.Capture(list)
        local limit = math.max(1, math.floor(IV.Limit))
        local present = {}
        for _, e in ipairs(list) do present[e.Tool] = true end

        local char = LocalPlayer.Character
        local new, inNew = {}, {}
        for _, e in ipairs(IV.Items) do
            local parent = e.Tool.Parent
            if present[e.Tool] and parent and #new < limit and (parent == char or IV.AutoEquip) then
                if parent ~= char then pcall(function() e.Tool.Parent = char end) end
                table.insert(new, e)
                inNew[e.Tool] = true
            end
        end
        for _, e in ipairs(list) do
            if #new >= limit then break end
            if not inNew[e.Tool] then
                e.WasEquipped = e.Tool.Parent == LocalPlayer.Character
                if IV.Attach(e) then
                    table.insert(new, e)
                    inNew[e.Tool] = true
                end
            end
        end
        for _, e in ipairs(IV.Items) do
            if not inNew[e.Tool] then IV.Release(e) end
        end
        IV.Items = new
    end

    function IV.Guard()
