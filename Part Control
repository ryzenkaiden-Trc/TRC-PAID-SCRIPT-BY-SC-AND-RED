local GameList = GameTab:AddSection("Game List")

local GameGroups = {
    { Name = "Unweld", Games = Config.Games },
    { Name = "NPC", Games = Config.NPCGames },
    { Name = "Item Visualizer", Games = Config.ItemGames },
}

local function TrackRow(grp, row)
    local item = row:FindFirstChildWhichIsA("GuiObject")
    table.insert(grp.Rows, { Row = row, Item = item, Home = item and item.Position })
end

for _, grp in ipairs(GameGroups) do
    grp.Rows = {}
    for _, g in ipairs(grp.Games or {}) do
        TrackRow(grp, GameList:AddGame(g).Parent)
    end
    TrackRow(grp, GameList:AddText("And More Coming Soon.", {
        Font = Enum.Font.GothamMedium, Size = 13, Color = Theme.SubText,
    }).Holder)
end

for k = 2, #GameGroups do
    for _, r in ipairs(GameGroups[k].Rows) do r.Row.Visible = false end
end

local ActiveGroup, Swapping = 1, false

local function SwapGroup(index)
    if Swapping or index == ActiveGroup then return false end
    Swapping = true
    local dir = index > ActiveGroup and 1 or -1
    local old, new = GameGroups[ActiveGroup], GameGroups[index]
    ActiveGroup = index

    for i, r in ipairs(old.Rows) do
        if r.Item then
            task.delay((i - 1) * 0.03, function()
                Tween(r.Item, 0.26, { Position = r.Home + UDim2.fromOffset(-dir * 400, 0) },
                    Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            end)
        end
    end

    task.delay(0.28 + math.max(#old.Rows - 1, 0) * 0.03, function()
        for _, r in ipairs(old.Rows) do
            r.Row.Visible = false
            if r.Item then r.Item.Position = r.Home end
        end
        for i, r in ipairs(new.Rows) do
            if r.Item then r.Item.Position = r.Home + UDim2.fromOffset(dir * 400, 0) end
            r.Row.Visible = true
            if r.Item then
                task.delay((i - 1) * 0.05, function()
                    Tween(r.Item, 0.6, { Position = r.Home }, Enum.EasingStyle.Back)
                end)
            end
        end
        task.delay(0.35, function() Swapping = false end)
    end)
    return true
end

