local function fit()
    local vp = Gui.AbsoluteSize
    if vp.X <= 0 or vp.Y <= 0 then return end
    local base = math.min((vp.X - 24) / BASE_W, (vp.Y - 24) / BASE_H)
    local s = math.clamp(base, 0.45, 1) * TRC.UserScale
    FitScale.Scale = math.min(s, math.max(base, 0.45))
end
Bind(Gui:GetPropertyChangedSignal("AbsoluteSize"), fit)
task.defer(fit)

function TRC:Unload(instant)
    for _, c in ipairs(self.Connections) do pcall(function() c:Disconnect() end) end
    self.Connections = {}
    local function kill()
        pcall(function() Blur:Destroy() end)
        pcall(function() Gui:Destroy() end)
        if getgenv and getgenv().TRC_TEST_UI == self then getgenv().TRC_TEST_UI = nil end
    end
    if instant then
        kill()
    else
        self.Open = true
        self:SetOpen(false)
        Tween(Launcher, 0.3, { Position = Launcher.Position + UDim2.fromOffset(-80, 0) })
        task.delay(0.5, kill)
    end
end

