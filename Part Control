        Tactile(ob, ob, 0.98, 0.93, function(inp) Ripple(ob, inp) end)
        ob.MouseButton1Click:Connect(function()
            if multi then
                local nv = {}
                for k, on in pairs(obj.Value) do nv[k] = on end
                nv[v] = (not nv[v]) or nil
                obj:Set(nv)
            else
                obj:Set(v)
                setOpen(false)
            end
        end)
    end

    Tactile(body, body, 0.97, 0.94, function(i) Ripple(body, i) end)
    body.MouseButton1Click:Connect(function() setOpen(not open) end)

    local d = opts.Default
    if multi then
        if type(d) == "table" then
            local init = {}
            for _, name in ipairs(d) do init[name] = true end
            obj:Set(init, true)
        else
            obj:Set({}, true)
        end
    else
        if type(d) == "number" then d = values[d] end
        obj:Set(d, true)
    end
    TRC.Flags[flag] = obj
    return obj
end

