function Section:AddSlider(flag, opts)
    opts = opts or {}
    local min, max = opts.Min or 0, opts.Max or 100
    local rounding = opts.Rounding or 0
    local mult = 10 ^ rounding
    local H = Mobile and 60 or 54
    local holder = RowHolder(self.Frame, H, self:_order())
    local body = Body(holder, "TextButton")
    Create("TextLabel", {
        BackgroundTransparency = 1, Text = opts.Text or flag, Font = Enum.Font.GothamMedium, TextSize = 14,
        TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
        Position = UDim2.fromOffset(12, 6), Size = UDim2.new(0.6, 0, 0, 18), Parent = body,
    })
    local valueLabel = Create("TextLabel", {
        BackgroundTransparency = 1, Text = "", Font = Enum.Font.GothamBold, TextSize = 13,
        TextColor3 = Theme.Accent, TextXAlignment = Enum.TextXAlignment.Right,
        Position = UDim2.new(0.5, 0, 0, 6), Size = UDim2.new(0.5, -12, 0, 18), Parent = body,
    })
    local track = Create("Frame", {
        AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 12, 1, -14), Size = UDim2.new(1, -24, 0, 6),
        BackgroundColor3 = Theme.Off, BorderSizePixel = 0, Parent = body,
    }, { Round() })
    local fill = Create("Frame", {
        BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Size = UDim2.fromScale(0, 1), Parent = track,
    }, { Round() })
    local knob = Create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(14, 14),
        BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 3, Parent = track,
    }, { Round() })
    local knobScale = Create("UIScale", { Parent = knob })

    local obj = { Value = opts.Default or min, Type = "Slider" }
    local function apply(v, silent)
        v = math.clamp(math.floor(v * mult + 0.5) / mult, min, max)
        local a = (max == min) and 0 or (v - min) / (max - min)
        Tween(fill, 0.1, { Size = UDim2.fromScale(a, 1) }, Enum.EasingStyle.Quad)
        Tween(knob, 0.1, { Position = UDim2.fromScale(a, 0.5) }, Enum.EasingStyle.Quad)
        valueLabel.Text = tostring(v) .. (opts.Suffix or "")
        if v ~= obj.Value or silent == "init" then
            obj.Value = v
            if not silent then Fire(opts.Callback, v) end
        end
    end
    function obj:Set(v, silent) apply(v, silent) end
    apply(obj.Value, "init")

    local scroller = self.Scroller
    local dragging = false
    local function fromX(x)
        local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        apply(min + (max - min) * a)
    end
    body.MouseEnter:Connect(function() if not dragging then Tween(knobScale, 0.25, { Scale = 1.2 }, Enum.EasingStyle.Back) end end)
    body.MouseLeave:Connect(function() if not dragging then Tween(knobScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back) end end)
    body.InputBegan:Connect(function(input)
        if input.UserInputType == MB1 or input.UserInputType == TOUCH then
            dragging = true
            scroller.ScrollingEnabled = false
            Tween(knobScale, 0.1, { Scale = 1.5 }, Enum.EasingStyle.Quad)
            Pulse(knob)
            fromX(input.Position.X)
        end
    end)
    Bind(UIS.InputChanged, function(input)
        if dragging and (input.UserInputType == MOVE or input.UserInputType == TOUCH) then
            fromX(input.Position.X)
        end
    end)
    Bind(UIS.InputEnded, function(input)
        if dragging and (input.UserInputType == MB1 or input.UserInputType == TOUCH) then
            dragging = false
            scroller.ScrollingEnabled = true
            Tween(knobScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
        end
    end)
    TRC.Flags[flag] = obj
    return obj
end

