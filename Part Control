function Picker:Select(plr, left)
    self.Selected = plr
    for p, rec in pairs(self.Rows) do SetRowSelected(rec, p == plr) end
    Fire(self.OnSelect, plr, left)
end

function Picker:Place()
    local s = math.max(FitScale.Scale, 0.01)
    local vp = Gui.AbsoluteSize
    local need = (PW + 14) * s
    local left = Holder.AbsolutePosition.X
    local right = left + Holder.AbsoluteSize.X
    if right + need <= vp.X then
        self.Side = "right"
        Panel.AnchorPoint = Vector2.new(0, 0)
        Panel.Size = UDim2.fromOffset(PW, BASE_H)
        self.BasePos = UDim2.new(1, 10, 0, 0)
        self.Slide = Vector2.new(-20, 0)
    elseif left - need >= 0 then
        self.Side = "left"
        Panel.AnchorPoint = Vector2.new(1, 0)
        Panel.Size = UDim2.fromOffset(PW, BASE_H)
        self.BasePos = UDim2.new(0, -10, 0, 0)
        self.Slide = Vector2.new(20, 0)
    else
        self.Side = "inside"
        Panel.AnchorPoint = Vector2.new(1, 0)
        Panel.Size = UDim2.fromOffset(PW, BASE_H - 52)
        self.BasePos = UDim2.new(1, -6, 0, 46)
        self.Slide = Vector2.new(20, 0)
    end
end

function Picker:Show()
    if self.Open then return end
    self.Open = true
    self:Place()
    Panel.Visible = true
    Panel.GroupTransparency = 1
    Panel.Position = self.BasePos + UDim2.fromOffset(self.Slide.X, self.Slide.Y)
    PanelScale.Scale = 0.9
    Tween(Panel, 0.45, { GroupTransparency = 0 })
    Tween(Panel, 0.7, { Position = self.BasePos })
    Tween(PanelScale, 0.7, { Scale = 1 }, Enum.EasingStyle.Back)
    ApplyFilter()
    PlayRowsIn()
    Fire(self.OnToggle, true)
end

function Picker:Hide()
    if not self.Open then return end
    self.Open = false
    Tween(Panel, 0.3, { GroupTransparency = 1 })
    Tween(Panel, 0.35, { Position = self.BasePos + UDim2.fromOffset(self.Slide.X, self.Slide.Y) },
        Enum.EasingStyle.Quint, Enum.EasingDirection.In)
    Tween(PanelScale, 0.35, { Scale = 0.92 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
    task.delay(0.36, function()
        if not self.Open then Panel.Visible = false end
    end)
    Fire(self.OnToggle, false)
end

function Picker:Toggle()
    if self.Open then self:Hide() else self:Show() end
end

