local function FetchBanner(placeId)
    local getAsset = getcustomasset or getsynasset
    if not (getAsset and writefile) then return nil end

    local idStr = ("%.0f"):format(placeId)
    local path = BannerFolder .. "/" .. idStr .. ".png"

    if isfile and isfile(path) then
        local ok, asset = pcall(getAsset, path)
        if ok and asset then return asset end
    end

    local uni = JSON(HttpGet("https://apis.roblox.com/universes/v1/places/" .. idStr .. "/universe"))
    local uid = uni and uni.universeId
    if not uid then return nil end
    uid = ("%.0f"):format(uid)

    local th = JSON(HttpGet("https://thumbnails.roblox.com/v1/games/multiget/thumbnails?universeIds=" .. uid
        .. "&countPerUniverse=1&defaults=true&size=768x432&format=Png&isCircular=false"))
    local e = th and th.data and th.data[1]
    local t = e and e.thumbnails and e.thumbnails[1]
    local url = ValidUrl(t and t.imageUrl)
    if not url then
        local ic = JSON(HttpGet("https://thumbnails.roblox.com/v1/games/icons?universeIds=" .. uid
            .. "&returnPolicy=PlaceHolder&size=256x256&format=Png&isCircular=false"))
        local d = ic and ic.data and ic.data[1]
        url = ValidUrl(d and d.imageUrl)
    end
    if not url then return nil end

    local bytes = HttpGet(url)
    if not bytes then return nil end
    pcall(function()
        if makefolder and isfolder and not isfolder(BannerFolder) then makefolder(BannerFolder) end
    end)
    if not pcall(writefile, path, bytes) then return nil end
    local ok, asset = pcall(getAsset, path)
    if ok and asset then return asset end
    return nil
end

local function DecodeBase64(data)
    local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local map = {}
    for i = 1, #chars do
        map[string.byte(chars, i)] = i - 1
    end
    data = string.gsub(data, "[^%w%+/]", "")
    local out, n = {}, 0
    for i = 1, #data, 4 do
        local a = map[string.byte(data, i)]
        local b = map[string.byte(data, i + 1)]
        local c = map[string.byte(data, i + 2)]
        local d = map[string.byte(data, i + 3)]
        if not (a and b) then break end
        local v = a * 262144 + b * 4096 + (c or 0) * 64 + (d or 0)
        n += 1
        out[n] = string.char(math.floor(v / 65536))
        if c then
            n += 1
            out[n] = string.char(math.floor(v / 256) % 256)
        end
        if d then
            n += 1
            out[n] = string.char(v % 256)
        end
    end
    return table.concat(out)
end

local function LoadPhoto(path, data)
    local getAsset = getcustomasset or getsynasset
    if not (getAsset and writefile) then return nil end
    if type(path) ~= "string" or path == "" then return nil end

    pcall(function()
        local folder = string.match(path, "^(.+)/[^/]+$")
        if folder and makefolder and isfolder and not isfolder(folder) then makefolder(folder) end
    end)

    local exists = false
    if isfile then
        local ok, r = pcall(isfile, path)
        exists = ok and r == true
    end

    if not exists then
        if type(data) ~= "string" or data == "" then return nil end
        if not pcall(writefile, path, DecodeBase64(data)) then return nil end
    end

    local ok, asset = pcall(getAsset, path)
    if ok and asset then return asset end
    return nil
end

local GameCCU = { Cards = {}, Universes = {}, Running = false }

function GameCCU.Format(n)
    local s = ("%.0f"):format(n)
    local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
    return (out:gsub("^,", ""))
end

function GameCCU.Resolve(placeId)
    local key = ("%.0f"):format(placeId)
    if GameCCU.Universes[key] then return GameCCU.Universes[key] end
    local uni = JSON(HttpGet("https://apis.roblox.com/universes/v1/places/" .. key .. "/universe"))
    local uid = uni and uni.universeId
    if uid == nil then return nil end
    uid = type(uid) == "number" and ("%.0f"):format(uid) or tostring(uid)
    GameCCU.Universes[key] = uid
    return uid
end

function GameCCU.Refresh()
    local ids, seen = {}, {}
    for _, card in ipairs(GameCCU.Cards) do
        if card.Label.Parent then
            local uid = GameCCU.Resolve(card.PlaceId)
            if uid and not seen[uid] then
                seen[uid] = true
                table.insert(ids, uid)
            end
        end
    end

    local counts = {}
    if #ids > 0 then
        local res = JSON(HttpGet("https://games.roblox.com/v1/games?universeIds=" .. table.concat(ids, ",")))
        if res and type(res.data) == "table" then
            for _, g in ipairs(res.data) do
                if type(g.id) == "number" and type(g.playing) == "number" then
                    counts[("%.0f"):format(g.id)] = g.playing
                end
            end
        end
    end

    for _, card in ipairs(GameCCU.Cards) do
        if card.Label.Parent then
            local uid = GameCCU.Universes[("%.0f"):format(card.PlaceId)]
            local n = uid and counts[uid]
            if n then
                card.Loaded = true
                card.Label.Text = GameCCU.Format(n) .. " active"
                Tween(card.Label, 0.3, { TextColor3 = Theme.Success })
            elseif not card.Loaded then
                card.Label.Text = "N/A"
            end
        end
    end
end

function GameCCU.Start()
    if GameCCU.Running then return end
    GameCCU.Running = true
    task.spawn(function()
        task.wait(1)
        while Gui.Parent do
            pcall(GameCCU.Refresh)
            task.wait(10)
        end
    end)
end

