    task.delay(0.6, function() ring:Destroy() end)
end

local function Tactile(hit, scaleTarget, hoverScale, downScale, onDown)
    hoverScale = hoverScale or 0.97
    downScale = downScale or 0.92
    local sc = scaleTarget:FindFirstChildOfClass("UIScale") or Create("UIScale", { Parent = scaleTarget })
    local hovering, pressed = false, false
    local function refresh()
        if pressed then
            Tween(sc, 0.08, { Scale = downScale }, Enum.EasingStyle.Quad)
        else
            local goal = hovering and hoverScale or 1
            Tween(sc, 0.35, { Scale = goal }, Enum.EasingStyle.Back)
        end
    end
    hit.MouseEnter:Connect(function() hovering = true; if not pressed then refresh() end end)
    hit.MouseLeave:Connect(function() hovering = false; pressed = false; refresh() end)
    hit.InputBegan:Connect(function(input)
        if input.UserInputType == MB1 or input.UserInputType == TOUCH then
            pressed = true
            refresh()
            if onDown then onDown(input) end
        end
    end)
    hit.InputEnded:Connect(function(input)
        if input.UserInputType == MB1 or input.UserInputType == TOUCH then
            pressed = false
            if input.UserInputType == TOUCH then hovering = false end
            refresh()
        end
    end)
    return sc
end

